# Files and directories useful for development but excluded from the
# CRAN tarball. Uses Perl-compatible regular expressions.

# Package sticker
^dplR_Sticker\.png$

# README source and rendered file
^README\.Rmd$
^README\.md$

# RStudio project files
^.*\.Rproj$
^\.Rproj\.user$

# Local R build configuration (Makevars, build.Renviron, check.Renviron)
^\.R$

# GitHub Actions workflows
^\.github$

# IDE-specific directories
^\.positai$
^\.claude$

# Developer docs, implementation plans, and release checklist
^00_README-developer$
^00_CRAN-release$
^00_PLAN-.*$

# Reverse dependency check directory (created by revdepcheck package)
^revdep$

# R CMD check artifact
^dplR-Ex\.R$

# LaTeX and knitr vignette build artifacts (relevant if building vignettes locally)
# NB: do not exclude inst/doc/*.Rnw -- R CMD build puts the vignette source
# there on purpose, and check WARNs if it is missing.
^vignettes/Rplots.*\.pdf$
^vignettes/figure(/.*)?$
^vignettes/.*\.(aux|bbl|blg|fdb_latexmk|fls|log|out|synctex\.gz|tex|toc)$
^inst/doc/cache(/.*)?$
^inst/doc/figure(/.*)?$
^inst/doc/.*\.(Rout|aux|bbl|blg|fdb_latexmk|fls|glo|gls|glg|idx|ind|ilg|lof|log|lot|out|synctex\.gz|toc)$
^.*/auto$
