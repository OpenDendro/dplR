S3method(as.data.frame, rwl.check)
S3method(summary, rwl)
S3method(summary, rwi)
S3method(print, summary.rwi)
S3method(as.data.frame, summary.rwi)
S3method(time, rwl)
S3method(time, rwi)
S3method(time, crn)
S3method("time<-", rwl)
S3method("time<-", rwi)
S3method("time<-", crn)
