# Files and directories useful for development but excluded from the
# CRAN tarball. Uses Perl-compatible regular expressions.

# Package sticker
^dplR_Sticker\.png$

# README source and rendered file
^README\.Rmd$
^README\.md$

# RStudio project files
^.*\.Rproj$
^\.Rproj\.user$

# Local R build configuration (Makevars, build.Renviron, check.Renviron)
^\.R$

# GitHub Actions workflows
^\.github$

# IDE-specific directories
^\.positai$
^\.claude$

# Developer docs, implementation plans, and release checklist
^00_README-developer$
^00_CRAN-release$
^00_PLAN-.*$

# Reverse dependency check directory (created by revdepcheck package)
^revdep$

# R CMD check artifact
^dplR-Ex\.R$

# Vignette build artifacts left behind by rendering math-dplR.Rmd in place.
# R CMD build makes its own copies under inst/doc; these are just local litter.
# NB: do not exclude inst/doc/*.Rmd -- R CMD build puts the vignette source
# there on purpose, and check WARNs about build/vignette.rds if it is missing.
^vignettes/.*\.html$
^vignettes/figure(/.*)?$
^vignettes/Rplots.*\.pdf$
