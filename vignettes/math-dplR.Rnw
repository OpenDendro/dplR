PAGE_WIDTH <- 4.74
PAGE_HEIGHT <- 8.22
knitr::opts_template$set(
    myfigures = list(fig.path = "figure/", fig.pos = "tbp",
                     fig.align = "center", fig.lp = "fig:"))
## A colour-blind-safe palette (Okabe and Ito)
